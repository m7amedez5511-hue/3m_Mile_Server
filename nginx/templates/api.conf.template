# Rendered by the official nginx image entrypoint (envsubst).
# API_SERVER_NAME — e.g. 3mMile.slash.sa (prod) or localhost (dev)
# API_UPSTREAM_HOST — e.g. 3mMile-app

upstream 3mMile_api {
    server ${API_UPSTREAM_HOST}:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name ${API_SERVER_NAME};

    location / {
        proxy_pass http://3mMile_api;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 60s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    # The app mounts its health route at /api/v1/health (routes/index.js is
    # mounted at /api/v1), so proxying to /api/health returned 404 — this probe
    # reported the API unhealthy no matter what state it was actually in.
    #
    # The proxy headers are repeated deliberately: a `location` block does NOT
    # inherit proxy_set_header from a sibling, and the app runs with
    # `trust proxy 1`, so without them req.ip resolved to the nginx container
    # and every health request shared one rate-limit bucket.
    location /api/health {
        proxy_pass http://3mMile_api/api/v1/health;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        access_log off;
    }
}
